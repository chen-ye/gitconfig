# ==============================================================================
# Modular Git Configuration
# ==============================================================================
# Include this file in your ~/.gitconfig:
#   [include]
#       path = ~/Projects/gitconfig/gitconfig
# ==============================================================================

[include]
	# Modern Git defaults & hygiene
	path = git/defaults.inc

	# Editor, difftools, mergetools, and LFS
	path = git/tools.inc

	# General convenience aliases
	path = git/aliases.inc

	# GitHub credentials and Git Town
	path = git/github.inc

	# Stacked diff and branch workflow aliases
	path = git/stacked.inc

	# Difftastic structural diff aliases
	path = git/difftastic.inc

	# Git config-based hooks
	path = git/hooks.inc
